# The scratch application's environment.
#
# Copied over the clone by `dev/tools/app-test reset`, so `composer serve` and
# the suite both see this file — the same one a request would. A real application
# generates its own; this one is disposable and never deployed, so the secret is
# a fixed throwaway rather than something generated per build.
#
# `APP_ENV=local` is what makes the debug-tools module register its routes and
# record. It is set here rather than exported, because the application's loader
# discards inherited configuration before reading this file — a value set in the
# shell no longer reaches it.
APP_ENV=local

APP_SECRET=scratch-app-test-not-a-real-secret
