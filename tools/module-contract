#!/usr/bin/env bash
#
# Check that every package in the workspace is shaped the way its role requires.
#
#     dev/tools/module-contract
#
# ## Why this lives here and not in principle
#
# Enforcing the rule needs to see every package at once, and `principle` is the one
# package that must not reach outward. A test inside the framework that read
# `../auth/composer.json` would be the inward dependency `docs/modules.md` argues
# against, wearing a test's clothes — and it would fail in every lone clone of the
# framework, which is most of the time. `dev` already knows about all six
# repositories, so the rule is checked from the one place that is allowed to know.
#
# ## What it checks
#
# A module is a `library` and requires the framework. An application is a
# `project` and requires its modules. The framework is a `library` and requires
# neither. Each of those is a fact about package roles that no single repository
# can verify alone, and each has a failure mode that is easy to ship past:
#
#   - a module marked `project` is not requireable as a dependency at all, and
#     Composer says so with a resolution error rather than a hint;
#   - a module requiring the *application* (rather than the framework) inverts the
#     whole architecture, and Composer will happily install it until the classes
#     stop existing at runtime;
#   - a framework that requires a module cannot be installed without it, which
#     defeats the point of the cut.
#
# And one rule about a single repository rather than about roles: `app/` ships no
# tests, no seeder and no test tooling. It is what a consumer copies, so anything
# committed there is something they inherit without asking. Its suite lives in
# `app-test/`, which `dev/tools/app-test` regenerates from this repository's own
# GitHub clone.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."

FRAMEWORK="iam-adty/empira-principle"
APP="iam-adty/empira-app"
# The one version line every library shares. See CHECKLIST.md §6: this is a
# development alias, deliberately ending in `-dev`, because Composer parses `0.1.0`
# and `0.0.1` as **stable** — so a `0.x` tag would mark a release. Nothing is
# tagged; a tag cannot move and would cost a constraint bump per consumer per change.
ALIAS="0.1.x-dev"

failures=0

field() { php -r '
    $j = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
    $path = explode(".", trim($argv[2], "."));
    foreach ($path as $k) {
        if (!is_array($j) || !array_key_exists($k, $j)) { echo ""; exit; }
        $j = $j[$k];
    }
    echo is_array($j) ? implode(",", $j) : (is_bool($j) ? var_export($j, true) : $j);
' "$1" "$2"; }

ok()   { printf '  \033[32mok\033[0m    %s\n' "$1"; }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; failures=$((failures + 1)); }

check() {
    local dir="$1" role="$2" expected_type="$3"
    local manifest="$dir/composer.json"

    if [ ! -f "$manifest" ]; then
        printf '\033[1m%s\033[0m — no composer.json\n' "$dir"
        failures=$((failures + 1))
        return
    fi

    local name type
    name=$(field "$manifest" name)
    type=$(field "$manifest" type)

    printf '\033[1m%s\033[0m — %s (%s)\n' "$dir" "$name" "$role"

    if [ "$type" = "$expected_type" ]; then
        ok "type is $type"
    else
        bad "type is '${type:-<unset>}', expected $expected_type"
    fi

    case "$role" in
        module)
            if [ "$(field "$manifest" "require.$FRAMEWORK")" = "dev-main" ]; then
                ok "requires $FRAMEWORK"
            else
                bad "does not require $FRAMEWORK (this is what makes it a module)"
            fi
            # The inversion, which is the one this script exists to catch. A
            # module requiring the application inverts the whole architecture:
            # Composer installs it happily, every test passes, and it breaks only
            # when the application is not there — which is precisely when the
            # module was supposed to be reusable.
            if [ -n "$(field "$manifest" "require.$APP")" ]; then
                bad "requires $APP — a module that needs an application is not a module"
            else
                ok "does not require an application"
            fi
            ;;
        application)
            local modules=0
            while IFS= read -r dep; do
                [ -n "$dep" ] || continue
                modules=$((modules + 1))
            done < <(php -r '
                $j = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
                foreach (array_keys($j["require"] ?? []) as $k) {
                    if (str_starts_with($k, "iam-adty/empira-")) { echo $k, "\n"; }
                }
            ' "$manifest")
            if [ "$modules" -gt 0 ]; then
                ok "requires $modules empira package(s) — an application closes the set"
            else
                bad "requires no empira packages; an application with no modules is a framework clone"
            fi
            ;;
        framework)
            local bad_deps
            bad_deps=$(php -r '
                $j = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
                foreach (array_keys($j["require"] ?? []) as $k) {
                    if (str_starts_with($k, "iam-adty/empira-")) { echo $k, "\n"; }
                }
            ' "$manifest")
            if [ -z "$bad_deps" ]; then
                ok "depends on no empira package — the dependency runs outward"
            else
                bad "depends on $(echo "$bad_deps" | tr '\n' ' ') — core cannot require a feature"
            fi
            ;;
    esac

    # A library's lock is not committed; a project's is. Getting this wrong is
    # silent: an application that ships without a lock resolves floating, and a
    # library that commits one pins its consumers to versions it never chose.
    #
    # Tracked, not present. `composer install` writes a `composer.lock` into every
    # package including libraries, and it is gitignored there — so the file is
    # almost always on disk and almost never committed, and asking the filesystem
    # reports the opposite of the truth.
    local tracked
    tracked=$(git -C "$dir" ls-files --error-unmatch composer.lock 2>/dev/null || true)

    if [ "$role" = "application" ]; then
        [ -n "$tracked" ] && ok "ships a lock — a project pins what it deploys" \
            || bad "no committed composer.lock; a deployed project without one is not reproducible"
    else
        [ -n "$tracked" ] && bad "commits composer.lock; that is a project's decision" \
            || ok "no committed lock — a library leaves resolution to its consumers"
    fi

    # The version line. A library aliases its branch so a consumer can express a
    # version constraint before anything is released; a project does not, because
    # a project is not versioned.
    #
    # The libraries must *agree*, and that is the part that rots. Three manifests
    # carrying the same line by hand drifts the first time one is edited alone, and
    # a library on `0.2.x-dev` while its framework is on `0.1.x-dev` resolves
    # nothing — as a resolution error in the consumer, pointing at the consumer.
    local alias
    alias=$(field "$manifest" "extra.branch-alias.dev-main")

    if [ "$role" = "application" ]; then
        [ -z "$alias" ] && ok "declares no branch alias — a project is not versioned" \
            || bad "declares branch alias '$alias'; a project is not versioned"
    else
        if [ -z "$alias" ]; then
            bad "no branch alias; a library should say what its dev version means"
        elif [ "$alias" != "$ALIAS" ]; then
            bad "branch alias is '$alias', workspace uses '$ALIAS'"
        else
            ok "branch alias $ALIAS"
        fi
    fi

    # No releases yet, so no tags. A tag is the thing that makes Composer treat a
    # version as stable, and `0.x` would have done that silently — Composer parses
    # 0.1.0 as stable. Delete this check the day there is a real consumer and a
    # deliberate first release; it exists to make "not released" enforceable rather
    # than a thing anyone has to remember.
    if [ "$role" != "application" ]; then
        local tags
        tags=$(git -C "$dir" tag 2>/dev/null | tr '\n' ' ')
        [ -z "$tags" ] && ok "untagged — no release has been cut" \
            || bad "tagged ($tags); nothing has been released and a tag makes a version stable to Composer"
    fi
}

echo "Package roles"

check principle framework library
check auth      module    library
check frankenphp module   library
check debugtools module  library
check app       application project

# The skeleton ships no test suite. This is the one rule here that protects a
# decision rather than a shape, and `app/` is exactly where a decision gets eroded:
# it is what a consumer copies, so a suite or a seeder committed there is something
# they inherit without asking. It shipped once — a manifest advertising
# `composer setup`, calling a `seed` command that did not exist, beside a suite
# asserting the application registered no commands at all.
#
# The suite now lives in `app-test/`, generated by `dev/tools/app-test` from this
# repository's own GitHub clone.
#
# Tracked, not present, for the reason the lock check above gives: `composer
# install` leaves a `vendor/` full of PHPUnit on disk in every package, so asking
# the filesystem reports a violation that is not one. This asks what would ship.
#
# Delete this when the skeleton is meant to grow a suite — which is the day that
# decision is revisited deliberately, not the day it happens quietly.
bare_skeleton() {
    local manifest="app/composer.json"

    printf '\n\033[1mapp/\033[0m — the skeleton ships nothing test-shaped\n'

    local leaked
    leaked=$(git -C app ls-files \
        | grep -E '^(tests/|phpunit\.xml$|tools/test$|\.phpunit)' \
        | tr '\n' ' ' || true)

    if [ -z "$leaked" ]; then
        ok "no test suite, no phpunit.xml — the skeleton stays bare"
    else
        bad "commits test scaffolding ($leaked); it belongs in app-test/, which is generated"
    fi

    # A `require-dev` on phpunit is the same decision made in the manifest, and it
    # is invisible in review — a diff adding one line to a dependency list looks
    # like a dependency bump.
    local dev
    dev=$(php -r '
        $j = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
        foreach (array_keys($j["require-dev"] ?? []) as $k) {
            if (str_contains($k, "phpunit")) { echo $k, " "; }
        }
    ' "$manifest")

    if [ -z "$dev" ]; then
        ok "requires no test tooling"
    else
        bad "requires $dev in require-dev — a consumer who wants the skeleton should not inherit a test framework"
    fi

    # Presence only, not the value: `autoload-dev` is a nested map, and interpolating
    # one produces a multi-line message that wraps the failure onto the next line.
    if php -r '
        $j = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
        exit(isset($j["autoload-dev"]) && $j["autoload-dev"] !== [] ? 1 : 0);
    ' "$manifest"; then
        ok "declares no autoload-dev — there is no suite left for it to point at"
    else
        bad "declares autoload-dev; there is no tests/ directory for it to point at"
    fi

    # The signing secret, on the same reasoning: `app/` now refuses to start
    # without `APP_SECRET` in `.env`, so a `.env` committed here is not a stray
    # file but a working production key in a repository anybody can clone.
    #
    # `app/.gitignore` lists `/.env`, so this is close to asking whether the
    # ignore rule still exists — which is the question worth asking. Removing that
    # one line to "get the app running" is the most likely way this happens, and it
    # is invisible in a diff among dozens.
    #
    # `app-test/` has one committed, deliberately: it is a disposable scratch
    # application with a fixed throwaway value, and it is not a repository.
    local env_tracked
    env_tracked=$(git -C app ls-files --error-unmatch .env 2>/dev/null || true)

    if [ -z "$env_tracked" ]; then
        ok "commits no .env — the signing secret is not in the repository"
    else
        bad "commits .env; APP_SECRET is a production key and .env is gitignored"
    fi

    # And the ignore rule that keeps it that way, checked for the same reason:
    # its absence is how the line above gets violated.
    if grep -qx '/\.env' app/.gitignore 2>/dev/null; then
        ok "ignores /.env, so the secret cannot be added by accident"
    else
        bad "no '/.env' in app/.gitignore; a secret would be one `git add -f` away"
    fi

    # The exact breakage that started this: a script naming a command the
    # application does not have. `composer setup` was the first thing anyone ran on
    # a fresh clone, and it failed every time.
    local scripts
    scripts=$(php -r '
        $j = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
        foreach (array_keys($j["scripts"] ?? []) as $k) {
            if (in_array($k, ["test", "setup", "seed"], true)) { echo $k, " "; }
        }
    ' "$manifest")

    if [ -z "$scripts" ]; then
        ok "offers no test, setup or seed script"
    else
        bad "advertises script(s) $scripts; 'setup' and 'seed' called a command this application never had"
    fi

    # The lock is committed, so a pruned requirement can still be carried in it and
    # installed as dead weight.
    if grep -q '"name": "phpunit/phpunit"' app/composer.lock 2>/dev/null; then
        bad "composer.lock still carries phpunit/phpunit; re-lock after removing it from the manifest"
    else
        ok "commits a lock with no test framework in it"
    fi
}

echo "The skeleton stays bare"

bare_skeleton

echo
if [ "$failures" -eq 0 ]; then
    echo "All packages are shaped correctly."
else
    echo "$failures problem(s) found." >&2
fi

exit $(( failures > 0 ? 1 : 0 ))